    "setup.importClaude.explanation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Exact Claude usage is optional. LimitLens can import your existing Claude Code OAuth token into its own Keychain item and use it only for usage checks." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El uso exacto de Claude es opcional. LimitLens puede importar tu token OAuth existente de Claude Code en su propio elemento del llavero y usarlo solo para consultar el uso." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'usage exact Claude est optionnel. LimitLens peut importer votre token OAuth Claude Code existant dans son propre élément Keychain et l'utiliser uniquement pour les lectures d'usage." } }
      }
    },
    "setup.importClaude.success" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code credentials imported." } },
