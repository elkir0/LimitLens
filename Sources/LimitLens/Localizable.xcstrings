    "setup.welcome.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose what LimitLens can read" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige lo que LimitLens puede leer" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez ce que LimitLens peut lire" } }
      }
    },
    "setup.welcome.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "LimitLens runs sandboxed. It needs your explicit permission for Codex and Claude Code folders. Widgets receive only a sanitized local snapshot." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "LimitLens se ejecuta en sandbox. Necesita tu permiso explícito para las carpetas de Codex y Claude Code. Los widgets solo reciben una instantánea local saneada." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "LimitLens fonctionne en sandbox. L'app a besoin de votre autorisation explicite pour les dossiers Codex et Claude Code. Les widgets reçoivent seulement un instantané local nettoyé." } }
      }
    },
